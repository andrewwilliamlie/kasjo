{
  "manifest_version": 2,
  "name": "Kasjo EDC bridge",
  "version": "1.0",
  "description": "Gives app.kasjo.site the window.KasjoEDC object (built-in PAX printer) inside the Kasjo EDC app.",
  "browser_specific_settings": { "gecko": { "id": "edc-bridge@kasjo.site" } },
  "content_scripts": [
    { "matches": ["https://app.kasjo.site/*"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": false }
  ],
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"]
}
