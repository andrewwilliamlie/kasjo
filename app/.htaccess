# Kasjo: settings for Hostinger (Apache / LiteSpeed)

# Always use HTTPS (needed for installing the app and sharing to WhatsApp)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

AddType application/manifest+json .webmanifest
DirectoryIndex index.html

# The page and the offline worker must never be cached by the browser, so updates show up
<FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
<FilesMatch "\.(png)$">
  Header set Cache-Control "public, max-age=2592000"
</FilesMatch>

Options -Indexes
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Hide repository internals and notes (the site is deployed from Git)
RedirectMatch 404 /\.git
RedirectMatch 404 /(README|DEPLOY)\.md$
